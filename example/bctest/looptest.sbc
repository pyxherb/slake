typename = {
	i64
}

ENTER
%any 0 = LTYPE 0
%any 1 = LVAR %any 0 // i
%any 2 = LVAR %any 0 // sum
loop:
	%i64 0 = LVALUEI64 %any 1
	%i64 1 = LVALUEI64 %any 2
	%i64 2 = ADDI64 %i64 0, 1
	%i64 3 = ADDI64 %i64 1, %i64 2
	STOREI64 %any 1, %i64 2
	STOREI64 %any 2, %i64 3
	%bool 0 = LTI64 %i64 2, 10000000
	BR %bool 0, loop, loop_end
loop_end:
LEAVE 1
